{
  "schemaName": "sales_transactions",
  "description": "Sales transaction data with product, customer, and amount information",
  "fields": [
    {
      "fieldName": "transaction_id",
      "fieldType": "STRING",
      "isRequired": true,
      "isDimension": false,
      "isMeasure": false,
      "isPrimaryKey": true,
      "description": "Unique transaction identifier"
    },
    {
      "fieldName": "product_name",
      "fieldType": "STRING",
      "isRequired": true,
      "isDimension": true,
      "isMeasure": false,
      "description": "Name of the product sold"
    },
    {
      "fieldName": "category",
      "fieldType": "STRING",
      "isRequired": true,
      "isDimension": true,
      "isMeasure": false,
      "description": "Product category",
      "validationRules": {
        "enum": ["Electronics", "Clothing", "Home", "Sports", "Food"]
      }
    },
    {
      "fieldName": "sales_amount",
      "fieldType": "NUMERIC",
      "isRequired": true,
      "isDimension": false,
      "isMeasure": true,
      "description": "Total sales amount",
      "validationRules": {
        "minimum": 0,
        "maximum": 999999.99
      }
    },
    {
      "fieldName": "quantity",
      "fieldType": "INTEGER",
      "isRequired": true,
      "isDimension": false,
      "isMeasure": true,
      "description": "Quantity sold",
      "validationRules": {
        "minimum": 1,
        "maximum": 10000
      }
    },
    {
      "fieldName": "region",
      "fieldType": "STRING",
      "isRequired": true,
      "isDimension": true,
      "isMeasure": false,
      "description": "Sales region",
      "validationRules": {
        "enum": ["North", "South", "East", "West", "Central"]
      }
    },
    {
      "fieldName": "sale_date",
      "fieldType": "DATE",
      "isRequired": true,
      "isDimension": true,
      "isMeasure": false,
      "description": "Date of sale (YYYY-MM-DD)"
    },
    {
      "fieldName": "customer_name",
      "fieldType": "STRING",
      "isRequired": false,
      "isDimension": true,
      "isMeasure": false,
      "description": "Customer name (optional)"
    },
    {
      "fieldName": "is_bulk_order",
      "fieldType": "BOOLEAN",
      "isRequired": false,
      "isDimension": false,
      "isMeasure": false,
      "description": "Whether this is a bulk order"
    }
  ]
}

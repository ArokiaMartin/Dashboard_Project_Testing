{
  "schemaName": "store_orders",
  "description": "Store orders with nested line items and payments. Nested arrays in the DATA (items, payments, and tags inside items) explode into separate related tables at ingestion time.",
  "fields": [
    {
      "fieldName": "order_id",
      "fieldType": "STRING",
      "isRequired": true,
      "isDimension": false,
      "isMeasure": false,
      "isPrimaryKey": true,
      "description": "Unique order identifier"
    },
    {
      "fieldName": "region",
      "fieldType": "STRING",
      "isRequired": true,
      "isDimension": true,
      "isMeasure": false,
      "description": "Sales region",
      "validationRules": {
        "enum": ["North", "South", "East", "West"]
      }
    },
    {
      "fieldName": "order_amount",
      "fieldType": "NUMERIC",
      "isRequired": true,
      "isDimension": false,
      "isMeasure": true,
      "description": "Total order amount",
      "validationRules": {
        "minimum": 0
      }
    },
    {
      "fieldName": "order_date",
      "fieldType": "DATE",
      "isRequired": true,
      "isDimension": true,
      "isMeasure": false,
      "description": "Date the order was placed (YYYY-MM-DD)"
    },
    {
      "fieldName": "is_priority",
      "fieldType": "BOOLEAN",
      "isRequired": true,
      "isDimension": true,
      "isMeasure": false,
      "description": "Whether the order is a priority shipment"
    }
  ]
}
